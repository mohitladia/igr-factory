# FreeLLM / OpenAI-compatible endpoint. Never commit your real key.
OPENAI_BASE_URL=http://127.0.0.1:31415/v1
OPENAI_API_KEY=
FREELLM_API_KEY=
OPENAI_MODEL=auto

# Voice settings
TTS_VOICE=en-IN-PrabhatNeural
TTS_RATE=+2%

# Video settings
VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
TARGET_DURATION_SECONDS=70

# Optional supporting-image generation (paid hosted API).
# Leave blank to use Remotion-generated visuals only.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell
ENABLE_AI_IMAGES=false
MAX_AI_IMAGES_PER_REEL=4

# Export
REMOTION_CODEC=h264
